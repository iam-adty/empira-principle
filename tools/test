#!/usr/bin/env bash
#
# Run the test suite in Docker.
#
# The rule this script exists to enforce: a green suite means the database
# tests actually ran. A Postgres suite that silently skipped is a green tick
# that means nothing, so the services are checked, started, and waited on —
# and if they cannot be started, this stops and says so rather than reporting
# a pass.
#
# And a green exit status means the suite *finished*. PHPUnit chooses that
# status in ShellExitCodeCalculator, which nothing reaches if the process exits
# first — so an `exit` anywhere in the code under test truncates the run, prints
# no summary, and exits 0. Measured, not assumed: a fixture with an `exit` in
# it stopped the suite after three tests and still returned success. Hence the
# summary check below, which is the only thing standing between that and a gate
# that means nothing.

set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v docker > /dev/null 2>&1; then
    cat >&2 <<'MESSAGE'
Docker is not on PATH, so the suite cannot run.

The whole suite runs in Docker. Install Docker, or run the SQLite-only
tests directly on a host PHP that has the extensions:

    vendor/bin/phpunit --exclude-group driver

MESSAGE
    exit 1
fi

if ! docker info > /dev/null 2>&1; then
    cat >&2 <<'MESSAGE'
The Docker daemon is not responding.

Start Docker (Docker Desktop, or `sudo systemctl start docker`) and run this
command again.
MESSAGE
    exit 1
fi

# Anything up already? `ps --status running` is the question that matters; the
# exit status of this command is deliberately ignored.
running=$(docker compose ps --status running --services 2>/dev/null || true)

if ! grep -qx postgres <<< "$running"; then
    echo "Starting the database services..." >&2

    if ! docker compose up -d --wait postgres; then
        cat >&2 <<'MESSAGE'

The PostgreSQL service did not come up. The suite cannot be trusted without it,
so nothing has been run.

To see what went wrong:

    docker compose logs postgres

Once it is up, start it yourself and re-run:

    docker compose up -d --wait postgres
    composer test

MESSAGE
        exit 1
    fi
fi

# `--name` because the runner is a one-off container: Compose ignores
# `container_name` for these, so `docker ps` would otherwise show a generated
# `empira-principle-php-run-<hash>`. The name is worth having for `docker logs`
# while a run is in flight.
#
# Deliberately no `--build`. The source is mounted from the host, so an edit is
# an edit in the runner and the image is built once, not per run.
#
# The autoloader is regenerated first, in the same container, because
# `tests/Fixtures/` is **classmapped** rather than PSR-4 — several fixtures share
# one file — and the classmap in `vendor/` was generated when the image was
# built. Without this, adding a fixture file means the runner cannot find the
# class, and the only cure is a rebuild, which contradicts mounting the source
# so that an edit needs no rebuild in the first place.
#
# `--colors=never` because phpunit.xml asks for colours and the summary check
# below would be matching ANSI escape codes instead of a line of text.
log=$(mktemp)
trap 'rm -f "$log"' EXIT

# `set -e` would abandon the pipeline the moment PHPUnit returned non-zero,
# taking the summary check with it, so the status is captured instead.
status=0
docker compose run --name empira-principle --rm php \
    sh -c 'composer dump-autoload --no-interaction --quiet && exec vendor/bin/phpunit --colors=never "$@"' \
    _ "$@" 2>&1 | tee "$log" || status=${PIPESTATUS[0]}

if [ "$status" -ne 0 ]; then
    exit "$status"
fi

# PHPUnit reached its end and reported. `OK (...)` is a clean run and
# `Tests: ...` is a run with failures — but the latter already exited non-zero
# above, so at this point the absence of either means the process ended early.
if ! grep -qE '^(OK|Tests:)' "$log"; then
    cat >&2 <<'MESSAGE'

The suite did not finish.

PHPUnit exited successfully but printed no summary, which means the PHP process
ended before PHPUnit's exit code was calculated — an `exit` or `die` somewhere in
the code under test, or a fatal error with the exit status swallowed.

The run above is truncated: some tests never ran. Anything asserted about "the
suite passes" from this run is void.

MESSAGE
    exit 1
fi

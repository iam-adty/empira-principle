{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "AGENTS.md",
        "CONTRIBUTING.md",
        "docs/components.md",
        "docs/routing.md",
        "docs/views.md",
        "docs/http.md",
        "docs/testing.md",
        "docs/workers.md",
        "docs/recipes.md"
    ],
    "permission": {
        "bash": {
            "*": "ask",
            "composer test": "allow",
            "composer validate": "allow",
            "vendor/bin/phpunit*": "allow",
            "php -l *": "allow",
            "php bin/empira *": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "docker compose *": "allow",
            "curl * 127.0.0.1*": "allow",
            "curl * localhost*": "allow",
            "grep *": "allow",
            "find *": "allow",
            "xargs *": "allow",
            "sed *": "allow",
            "sed -i*": "deny"
        }
    }
}

#!/usr/bin/env php
<?php

declare(strict_types=1);

use Empira\Console\Application;
use Empira\Console\Bootstrap;
use Empira\Console\Output;

/**
 * The `empira` console.
 *
 *     php bin/empira list
 *     php bin/empira make:component Counter
 *     php bin/empira migrate
 *     php bin/empira seed
 *     php bin/empira serve --port=8080
 *
 * The autoloader is looked for in both places Composer puts it: a standalone
 * checkout has `vendor/` beside `bin/`, an installed dependency has the
 * project's autoloader three levels up.
 */
(static function (): void {
    $candidates = [
        __DIR__ . '/../vendor/autoload.php',
        __DIR__ . '/../../../autoload.php',
    ];

    foreach ($candidates as $autoload) {
        if (is_file($autoload)) {
            require $autoload;

            return;
        }
    }

    fwrite(STDERR, 'empira: no Composer autoloader found. Run `composer install` first.' . PHP_EOL);

    exit(1);
})();

/**
 * Boot the project, if it has a bootstrap, and take its commands.
 *
 * This is what lets `empira seed` exist. {@see Empira\Console\Bootstrap}
 * owns the discovery so that the test suite drives the same console the
 * operator does.
 *
 * Registering the project's commands is inside the try as well as booting it,
 * because that is where a name collision is found: an application registering
 * `migrate` has done nothing wrong as far as `Application` knows — it cannot
 * know which names the framework ships — so the console is what refuses it. Left
 * outside, that refusal arrives as an uncaught `InvalidArgumentException` with a
 * stack trace through three vendor directories, for what is a sentence an
 * operator can act on.
 */
$console = new Application();

try {
    $booted = Bootstrap::boot(getcwd() ?: '.');

    if ($booted !== null) {
        foreach ($booted->commands() as $name => $command) {
            $console->project($name, $command);
        }

        $console->booted($booted);
    }
} catch (\Throwable $e) {
    fwrite(STDERR, 'empira: ' . $e->getMessage() . PHP_EOL);

    exit(1);
}

exit($console->run($argv, new Output()));

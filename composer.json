{
    "name": "iam-adty/empira-principle",
    "description": "A PHP framework where htmx lives in PHP classes, not HTML.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "htmx",
        "components",
        "hypermedia",
        "server-driven",
        "framework"
    ],
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.3",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.5",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Empira\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Empira\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures/"
        ]
    },
    "bin": [
        "bin/empira"
    ],
    "scripts": {
        "test": "tools/test",
        "test:sqlite": "tools/test --exclude-group driver"
    },
    "config": {
        "sort-packages": true
    }
}
